---
import { getCollection } from 'astro:content';
import Archive from '../../components/Archive.astro';

const entries = (await getCollection('projects')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Archive title="Projects" description="Projects done by FabioRosado" entries={entries} routePrefix="/projects/" />
