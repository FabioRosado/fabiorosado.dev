---
import { getCollection } from 'astro:content';
import Archive from '../../components/Archive.astro';

const entries = (await getCollection('blog')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Archive title="Articles" description="I write about code and share quick coding tips." entries={entries} routePrefix="/blog/" />
