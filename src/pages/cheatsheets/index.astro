---
import { getCollection } from 'astro:content';
import Archive from '../../components/Archive.astro';

const entries = (await getCollection('cheatsheets')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Archive title="Cheatsheets" description="Technical cheatsheets by Fabio Rosado." entries={entries} routePrefix="/cheatsheets/" />
